{
  "name": "webgl-grid",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "node scripts/test-all.mjs",
    "mcp": "node mcp/server.ts",
    "lint": "oxlint --deny-warnings src mcp e2e scripts electron vite.config.ts playwright.config.ts",
    "electron:main": "vite build --ssr electron/main.ts --outDir dist-electron --emptyOutDir",
    "electron": "npm run build && npm run electron:main && electron .",
    "electron:build": "npm run build && npm run electron:main && electron-builder --mac --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fflate": "^0.8.3",
    "mediabunny": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Blender 風の MMD ビューア・エディター (three.js)",
  "build": {
    "appId": "io.github.sparklingstadt.webgl-grid",
    "productName": "webgl-grid",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "webgl-grid ${version}"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    }
  },
  "author": "Sparklingstadt"
}
